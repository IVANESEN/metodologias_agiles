# Desarrollo local: Node.js 24, npm ci y npm start. No contiene secretos.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
# Vacío usa PGlite en data/. DEMO_DATA=false evita cargar cuentas de demostración.
DATABASE_URL=
DATA_DIR=./data
DEMO_DATA=false
DATABASE_SCHEMA=constructora_private
# Solo Supabase: copiar referencia del panel y seleccionar su CA pública.
SUPABASE_PROJECT_REF=
DATABASE_SSL_CA_FILE=
# true únicamente tras verificar Exposed schemas en el panel de Supabase.
SUPABASE_DATA_API_REVIEWED=false
# Opcional: proveedor Resend para recuperación de contraseña.
# Despacho requiere acordar canal/destino e inyectar un adaptador; no tiene canal predeterminado.
RESEND_API_KEY=
MAIL_FROM=
