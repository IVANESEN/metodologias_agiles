{
  "name": "constructora-el-salvador",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sprint 0: catálogo y contratos de alquiler de maquinaria",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch backend/server.mjs",
