{
  "name": "constructora-el-salvador",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Constructora El Salvador: renta y venta de maquinaria pesada con portal multirrol, contratos y operación",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch backend/server.mjs",
    "test": "node --test backend/*.test.mjs",
    "db:inspect": "node --env-file-if-exists=.env backend/inspect-db.mjs",
    "db:init": "node --env-file-if-exists=.env backend/init-db.mjs",
    "db:verify": "node --env-file-if-exists=.env backend/verify-db.mjs",
    "db:demo": "node --env-file-if-exists=.env backend/cargar-demo.mjs",
    "db:portal": "node --env-file-if-exists=.env backend/preparar-portal.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "pdfkit": "0.20.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "pdfjs-dist": "6.4.299"
  }
}
