# Copia este archivo a .env SOLO si .env no existe. Nunca subas .env a Git.
# Supabase > Constructora_ElSalvador > Connect > Session pooler > URI.
# Sustituye cada marcador por el valor exacto del panel, sin compartirlo en chat.
DATABASE_URL="postgresql://USUARIO_DEL_PANEL:CONTRASENA_CODIFICADA@HOST_DEL_PANEL:PUERTO_DEL_PANEL/BASE_DEL_PANEL"
SUPABASE_PROJECT_REF=hqhkpuaxnisfxicvjsmn
DATABASE_SCHEMA=constructora_private
# Certificado raíz público oficial de Supabase incluido en el repositorio.
# Siempre se verifica el certificado y el nombre del servidor.
DATABASE_SSL_CA_FILE=database/certs/supabase-prod-ca-2021.crt
# Cambia a true SOLO después de comprobar Data API apagada o que
# constructora_private NO está en Exposed schemas del panel.
SUPABASE_DATA_API_REVIEWED=false
HOST=127.0.0.1
PORT=3000
